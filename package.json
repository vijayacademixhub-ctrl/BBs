{
  "name": "academicos",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "verify:m1": "npm run verify:m1 --workspace apps/web",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:all": "npm run test && npm run test:db",
    "db:reset": "node scripts/db-reset.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "vitest": "^5.1.0"
  }
}
