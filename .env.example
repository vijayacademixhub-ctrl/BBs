# AcademicOS — environment configuration template.
#
# Copy to .env and fill in real values. NEVER commit .env; it is git-ignored.
# This file contains placeholder names only and must never contain a real key.
#
# The division below is a security boundary, not an organisational one.
# Anything prefixed VITE_ is compiled into the browser bundle and is therefore
# public. Everything under "server only" must never acquire that prefix.

# ======================================================== FRONTEND (public)
#
# These values are embedded in the published JavaScript. That is expected for
# both of them: the publishable key grants nothing on its own, because every
# row it can reach is decided by Row Level Security against the signed-in
# user's token.
#
# Leave them empty to run the application on local demonstration data. It
# will say so on every screen and will not offer a working sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The AI service, reached through a Cloudflare Tunnel. Not used before M4.
VITE_AI_SERVICE_URL=

# ==================================================== SERVER ONLY (secrets)
#
# Read by the Python AI service on the Windows host. These must never be
# given a VITE_ prefix and must never appear in apps/web.
#
# The service-role key bypasses Row Level Security completely. Anyone holding
# it can read every recording, transcript and daily report in the system.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------ AI provider
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Transcription. Kept configurable so accuracy across English, Kannada and
# Hindi can be benchmarked before a model is settled on.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto

# Cloud provider placeholder — credentials to be supplied later.
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=

# ---------------------------------------------------------------- Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ================================================================ RETENTION
#
# Retention is NOT configured here, deliberately.
#
# A 90-day audio retention period was proposed and has not been approved, so
# no period is set anywhere in this system. Retention lives in the
# public.retention_policies table, where every scope is disabled and marked
# pending approval, and a database constraint prevents any of them being
# switched on without a recorded approver and an approved period.
#
# Putting a number in an environment variable would make it look settled and
# would let a deployment quietly start deleting institutional records.
# See docs/retention-and-consent.md.

# ================================================================== TESTING
#
# PostgreSQL connection for the database security suite (npm run test:db).
# A local throwaway database — never a production connection string.
ACADEMICOS_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/academicos_test
