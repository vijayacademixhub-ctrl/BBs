# AcademicOS — environment configuration template.
# Copy to .env and fill in real values. NEVER commit .env.
# Placeholders only: this file must never contain a real key.

# ---------------------------------------------------------------- Frontend
# Vite exposes only VITE_-prefixed variables to the browser. Never put a
# secret here: anything with this prefix ends up in the published bundle.
# Milestone 1 uses local sample data and needs none of these.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AI_SERVICE_URL=

# ------------------------------------------------- AI service (server only)
# These are read by the Python service on the Windows host. They are never
# sent to the browser and must not be given a VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Transcription. Kept configurable so accuracy can be benchmarked across
# English, Kannada and Hindi before a model is fixed (M1 decision 2).
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto

# Cloud provider placeholder — credentials supplied later.
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=

# ------------------------------------------------------------------ Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ---------------------------------------------------------------- Retention
# Original audio is deleted this many days after transcript approval,
# subject to institutional approval (M1 decision 4). Approved transcripts
# are retained until an authorised deletion.
AUDIO_RETENTION_DAYS=90
